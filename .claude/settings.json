{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(.venv/bin/pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(cat .env:*)",
      "Bash(gh repo delete:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
